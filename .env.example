# ============================================================
#  DataIA — modèle de configuration
#  Copier ce fichier en ".env" puis adapter les valeurs.
#  Le fichier .env n'est JAMAIS commité (voir .gitignore).
# ============================================================

# ---------- Flask ----------
# Clé de signature des sessions. Générer une valeur avec :
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# 1 = mode debug (développement uniquement)
FLASK_DEBUG=0
MAX_UPLOAD_MB=20

# ---------- MySQL (WampServer) ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dataia

# ---------- Ollama (LLM local) ----------
# 127.0.0.1 et non localhost : sous Windows, localhost essaie d'abord IPv6 (::1)
# alors qu'Ollama n'écoute qu'en IPv4 -> 2,3 s perdues par connexion (mesuré)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen2.5:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TEMPERATURE=0
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=800
OLLAMA_TIMEOUT=180
# 0 = 100 % CPU (plus rapide sur MX130 : 8,7 contre 3,2 tokens/s mesurés) ; vide = automatique
OLLAMA_NUM_GPU=0
# Garder le modèle en mémoire entre deux questions
OLLAMA_KEEP_ALIVE=30m
# 1 = le LLM reformule le résultat calculé par pandas (vérifié), 0 = phrase modèle seule
REFORMULATION_LLM=1

# ---------- RAG / FAISS ----------
# 5 extraits : chaque ligne coûte ~70 tokens de prompt (~2 s sur CPU) ; les lignes exactes passent en premier
RAG_TOP_K=5
EMBEDDING_DIM=768

# ---------- Chemins (relatifs au dossier DataIa) ----------
UPLOAD_FOLDER=uploads
VECTOR_FOLDER=uploads/vector_indices
REPORT_FOLDER=uploads/rapports

# ---------- Multilingue ----------
# Langue de réponse quand la question est en derja (fr ou ar)
DERJA_LATIN_REPONSE=fr
DERJA_ARABE_REPONSE=ar

# ---------- Sauvegardes et migrations de la base ----------
BACKUP_FOLDER=backups
MIGRATIONS_FOLDER=migrations
MYSQLDUMP_PATH=C:/wamp64/bin/mysql/mysql9.1.0/bin/mysqldump.exe

# ---------- Graphiques (Phase 4) ----------
GRAPH_FOLDER=uploads/graphiques
# Chrome installé sur la machine, utilisé par kaleido pour les PNG (vide = détection automatique)
CHROME_PATH=
GRAPH_MAX_CATEGORIES=20
GRAPH_MAX_PIE=6
GRAPH_MAX_POINTS=5000
