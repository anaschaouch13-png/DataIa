# ============================================================
#  DataIA — fichiers à ne pas versionner
# ============================================================

# Secrets et configuration locale (clé Flask, mot de passe MySQL)
.env
.env.*
!.env.example

# Python
venv/
.venv/
__pycache__/
*.py[cod]

# Données utilisateurs et fichiers générés (données personnelles / volumineuses)
uploads/
exports/
backups/

# Frontend (dépendances et build)
node_modules/
dist/

# Divers
.DS_Store
*.log
